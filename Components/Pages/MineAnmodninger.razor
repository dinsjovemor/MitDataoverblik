@page "/mine-anmodninger"
@attribute [Authorize]
@rendermode InteractiveServer
@using MitDataoverblik.Models
@using MitDataoverblik.Services
@inject RettelsesanmodningService AnmodningService
@using MitDataoverblik.Components.Shared
@inject BorgeroplysningService OplysningService
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider LoginstatusService

<PageTitle>Mine anmodninger</PageTitle>

<h1>Mine anmodninger</h1>
<p>
    <a href="/">Tilbage til dataoverblik</a>
</p>

<p>Her vises dine simulerede rettelsesanmodninger.</p>

@if (!anmodninger.Any())
{
    <p>Du har endnu ingen anmodninger.</p>

    <p>
        <a href="/opret-anmodning">Opret en anmodning om rettelse</a>
    </p>
}
@foreach (var anmodning in anmodninger)

{
    <Anmodningskort
        Anmodning="@anmodning"
        Betegnelse="@(oplysninger.FirstOrDefault(
            o => o.Id == anmodning.BorgeroplysningId)?.Betegnelse
            ?? "Ukendt oplysning")" />
}

@code {
    private List<Rettelsesanmodning> anmodninger = new();
    private List<Borgeroplysning> oplysninger = new();

    protected override async Task OnInitializedAsync()
    {
        var loginstatus =
            await LoginstatusService.GetAuthenticationStateAsync();

        var idTekst = loginstatus.User
            .FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (int.TryParse(idTekst, out var borgerId))
        {
            anmodninger = AnmodningService.HentAnmodninger(borgerId);
            oplysninger = OplysningService.HentOplysninger(borgerId);
        }
    }
}