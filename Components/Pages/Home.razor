@page "/"
@using MitDataoverblik.Models
@using MitDataoverblik.Services
@inject BorgerService BorgerService
@inject BorgeroplysningService OplysningService
@using MitDataoverblik.Components.Shared
@rendermode InteractiveServer


<PageTitle>MitDataoverblik</PageTitle>

<h1>Mit Dataoverblik</h1>
<p>
    Demonstration med fiktive borgeroplysninger.
    Myndighedstilknytningerne er simulerede.
</p>

@if (indlaeser)
{
    <p>Henter oplysninger...</p>
}
else if (borger is null)
{
    <p>Borgeren blev ikke fundet.</p>
}
else
{
    <h2>Mine oplysninger</h2>

    <dl>
        <dt>Navn</dt>
        <dd>@borger.Navn</dd>

        <dt>Adresse</dt>
        <dd>@borger.Adresse</dd>

        <dt>Myndighed</dt>
        <dd>@borger.Myndighed</dd>
    </dl>
}
<label for="soegning">Søg i dine oplysninger</label>
<input id="soegning"
       type="search"
       @bind="soegning"
       @bind:event="oninput" />

<label for="myndighed">Myndighed</label>
<select id="myndighed" @bind="valgtMyndighed">
    <option value="">Alle myndigheder</option>

    @foreach (var myndighed in oplysninger
        .Select(o => o.Myndighed).Distinct())
    {
        <option value="@myndighed">@myndighed</option>
    }
</select>

<label for="datatype">Datatype</label>
<select id="datatype" @bind="valgtDatatype">
    <option value="">Alle datatyper</option>

    @foreach (var datatype in oplysninger
        .Select(o => o.DataType).Distinct())
    {
        <option value="@datatype">@datatype</option>
    }
</select>
<button type="button" @onclick="NulstilFiltre">
    Nulstil søgning og filtre
</button>
<p>
    Viser @FiltreredeOplysninger.Count() af @oplysninger.Count oplysninger
    fra @FiltreredeOplysninger.Select(o => o.Myndighed).Distinct().Count()
    @(FiltreredeOplysninger.Select(o => o.Myndighed).Distinct().Count() == 1
        ? "myndighed" : "myndigheder").
</p>

@if (!FiltreredeOplysninger.Any())
{
    <p>Ingen oplysninger matcher din søgning og dine filtre.</p>
}
@foreach (var gruppe in FiltreredeOplysninger.GroupBy(o => o.Myndighed))
{
    <Myndighedskort Myndighed="@gruppe.Key"
                    Oplysninger="@gruppe.ToList()" />
}

@code {
    private void NulstilFiltre()
    {
        soegning = "";
        valgtMyndighed = "";
        valgtDatatype = "";
    }
    private string soegning = "";
    private Borger? borger;
    private List<Borgeroplysning> oplysninger = new();
    private bool indlaeser = true;
    private string valgtMyndighed = "";
    private string valgtDatatype = "";

    private IEnumerable<Borgeroplysning> FiltreredeOplysninger =>
    oplysninger.Where(o =>
        (string.IsNullOrEmpty(valgtMyndighed)
            || o.Myndighed == valgtMyndighed)
        &&
        (string.IsNullOrEmpty(valgtDatatype)
            || o.DataType == valgtDatatype)
        &&
        (o.Betegnelse.Contains(
            soegning, StringComparison.OrdinalIgnoreCase)
        || o.Værdi.Contains(
            soegning, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        borger = await BorgerService.HentBorgerAsync(1);
        oplysninger = OplysningService.HentOplysninger(1);
        indlaeser = false;
    }
}